{
  "name": "model-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "data": "tsx scripts/pipeline.ts",
    "data:offline": "tsx scripts/pipeline.ts --offline",
    "data:refresh": "tsx scripts/pipeline.ts --refresh",
    "pretest:e2e": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "test:ui": "playwright test tests/ui.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "lighthouse": "lhci autorun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
