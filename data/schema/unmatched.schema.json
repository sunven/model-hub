{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "board": {
        "type": "string",
        "enum": [
          "text",
          "webdev"
        ]
      },
      "modelName": {
        "type": "string"
      },
      "organization": {
        "type": "string"
      },
      "condition": {
        "type": "string"
      },
      "rating": {
        "type": "number"
      },
      "ciLow": {
        "type": "number"
      },
      "ciHigh": {
        "type": "number"
      },
      "rank": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "votes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "snapshotDate": {
        "type": "string"
      },
      "sourceRef": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "board",
      "modelName",
      "organization",
      "condition",
      "rating",
      "ciLow",
      "ciHigh",
      "rank",
      "votes",
      "snapshotDate",
      "sourceRef"
    ],
    "additionalProperties": false
  }
}
